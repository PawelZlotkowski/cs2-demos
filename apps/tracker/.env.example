# Shared storage (Upstash Redis). Adding the Upstash integration on Vercel sets
# KV_REST_API_URL / KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / _TOKEN) for you.
# Leave empty to keep changes in this browser only.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: shared passcode required to change tasks. Viewing stays open.
TRACKER_PASSCODE=
