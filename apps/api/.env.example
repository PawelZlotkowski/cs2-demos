# Round Reviewer API (optional)
# Copy to .env or export in the shell. Prefix is RR_.

# RR_DATA_DIR=
# RR_CORS_ORIGINS=["http://localhost:3000"]

# Gameplay video (Windows host with CS2 + CS Demo Manager)
# RR_CSDM_ENABLED=1
# RR_CSDM_MODE=stub
# RR_CSDM_BIN=csdm
# RR_CSDM_FOCUS_STEAMID=
# RR_CSDM_WIDTH=1280
# RR_CSDM_HEIGHT=720
# RR_CSDM_FPS=30
# RR_CSDM_RECORDING_SYSTEM=HLAE
# RR_CSDM_MAX_ROUNDS=1
# RR_CSDM_TIMEOUT_SECONDS=600
# The coach's moments are recorded from the picked player's view before the analysis opens;
# whole rounds only on request. Pads add seconds around the picked window (default 0).
# RR_CSDM_ROUND_CLIPS=0
# RR_CSDM_MOMENT_PAD_BEFORE=0
# RR_CSDM_MOMENT_PAD_AFTER=0
