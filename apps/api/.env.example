# Round Reviewer API (optional)
# Copy to .env or export in the shell. Prefix is RR_.

# RR_DATA_DIR=
# RR_CORS_ORIGINS=["http://localhost:3000"]

# Accounts, roles and the admin panel (doc 30). Off: everyone who can reach the API is the
# local admin, so keep the ports on 127.0.0.1. On: the first account made becomes the admin.
# RR_AUTH_ENABLED=true
# Who may make an account after the first: invite (default), open or closed
# RR_SIGNUP=invite
# RR_SESSION_DAYS=30
# Where the browser opens the web app; Steam returns here after sign-in
# RR_PUBLIC_URL=http://localhost:3000
# Optional: names and avatars for Steam accounts (https://steamcommunity.com/dev/apikey)
# RR_STEAM_API_KEY=
# Matches each account may upload with accounts on; admins have no limit (0 = none)
# RR_MAX_MATCHES_PER_USER=20
# Read-only share links for a reviewed match
# RR_SHARE_LINKS=false
# School user study: consent screen and pseudonymous export in the admin panel
# RR_STUDY_MODE=false
# /docs and /openapi.json. Unset: shown while accounts are off, hidden when on
# RR_API_DOCS=true

# Gameplay video (Windows host with CS2 + CS Demo Manager)
# RR_CSDM_ENABLED=1
# RR_CSDM_MODE=stub
# RR_CSDM_BIN=csdm
# RR_CSDM_FOCUS_STEAMID=
# RR_CSDM_WIDTH=1280
# RR_CSDM_HEIGHT=720
# RR_CSDM_FPS=30
# RR_CSDM_RECORDING_SYSTEM=HLAE
# RR_CSDM_MAX_ROUNDS=1
# RR_CSDM_TIMEOUT_SECONDS=600
# The coach's moments are recorded from the picked player's view before the analysis opens;
# whole rounds only on request. Pads add seconds around the picked window.
# RR_CSDM_ROUND_CLIPS=0
# RR_CSDM_MOMENT_PAD_BEFORE=1
# RR_CSDM_MOMENT_PAD_AFTER=3

# Admin Lab (doc 29): coach trace viewer at /lab/traces. Off by default, since traces hold player data.
# RR_LAB_ENABLED=1
# Lab Labels write data/labels files (committed); the Dataset tab exports to data/dataset (ignored by git)
# RR_LABELS_DIR=
# RR_DATASET_DIR=
