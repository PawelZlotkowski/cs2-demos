# Clip labeller (RR_WEB_MODE=clip-labeller). Placeholders only — never commit real values.
# Set these in the dedicated Vercel project (Production; separate values for Preview).
# None of them may use a NEXT_PUBLIC_ prefix.

RR_WEB_MODE=clip-labeller

# Supabase database (server only). Project Settings > API keys > Secret key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# At least 32 random bytes, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it invalidates every access code; reissue codes afterwards.
LABELER_CODE_PEPPER=REPLACE_WITH_RANDOM_SECRET

# The exact public origin of this deployment (https, no trailing slash).
LABELER_SITE_URL=https://YOUR_PROJECT.vercel.app

# Private R2 bucket, Object Read & Write token scoped to this bucket only.
# EU-jurisdiction buckets use https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=cs2-demo-clips

# Optional limits (defaults shown).
# LABELER_MAX_CLIP_BYTES=268435456        # 256 MiB per clip
# LABELER_MAX_TOTAL_BYTES=8589934592      # 8 GiB stored plus open reservations
# LABELER_MAX_CLIPS=1500
# LABELER_MAX_OPEN_UPLOADS=12
# LABELER_REVIEWER_SESSION_HOURS=168
# LABELER_ADMIN_SESSION_HOURS=12
# LABELER_LOGIN_LIMIT_PER_CLIENT=20       # attempts per 10 minutes per client
# LABELER_LOGIN_LIMIT_GLOBAL=500

# Local development only (refused on Vercel): a direct Postgres URL instead of Supabase,
# with LABELER_SITE_URL=http://localhost:3100. See docs/LABELLER-CLOUD.md.
# LABELER_DATABASE_URL=postgres://postgres:...@127.0.0.1:55432/labeler_dev?options=-c%20role%3Dservice_role
