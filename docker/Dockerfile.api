FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

COPY app ./app
# Fixtures live outside the writable data volume so sample match stays available.
COPY data/fixtures /app/fixtures

ENV RR_DATA_DIR=/app/data \
    RR_FIXTURE_PATH=/app/fixtures/sample-match.json

RUN mkdir -p /app/data/uploads /app/data/work /app/data/matches
RUN useradd --system --uid 10001 --create-home appuser \
    && chown -R appuser:appuser /app/data

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
