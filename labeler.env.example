# Copy to labeler.env for a source checkout. The portable ZIP includes its own configuration.
LABELER_PROJECT=round-labeler
LABELER_PORT=8765
LABELER_IMAGE=round-labeler-labeler
LABELER_BUILD_TARGET=runtime
LABELER_WORKER_MB=4096
LABELER_PARSE_TIMEOUT=900
# Optional lean build: change TARGET to core and IMAGE to round-labeler-core.
# CS Demo Manager on the Windows host connects to 127.0.0.1 and this published port.
CSDM_DB_PORT=5432
CSDM_DB_USER=postgres
CSDM_DB_NAME=csdm
# The launcher generates a local password when setting up a new database.
CSDM_DB_PASSWORD=
